---
import Calculator from '../components/Calculator';
import { locales, defaultLocale } from '../lib/i18n';
import '../styles/global.css';

const t = locales[defaultLocale];
---

<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.siteTitle}</title>
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('daysoff:theme');
        const prefersDark = window.matchMedia(
          '(prefers-color-scheme: dark)',
        ).matches;
        const isDark = stored ? stored === 'dark' : prefersDark;
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>
  </head>
  <body
    class="min-h-screen bg-stone-50 text-stone-900 antialiased dark:bg-stone-950 dark:text-stone-100"
  >
    <div
      class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-[28rem] bg-[radial-gradient(ellipse_60%_50%_at_50%_-10%,#fef3c7,transparent)] dark:bg-[radial-gradient(ellipse_60%_50%_at_50%_-10%,#451a03,transparent)]"
    >
    </div>
    <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
      <Calculator client:load />
    </main>
  </body>
</html>
