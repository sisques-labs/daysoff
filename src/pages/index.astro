---
import Calculator from '../components/Calculator';
import { t } from '../lib/i18n';
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.siteTitle}</title>
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900 antialiased">
    <div
      class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-[28rem] bg-[radial-gradient(ellipse_60%_50%_at_50%_-10%,#fef3c7,transparent)]"
    >
    </div>
    <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
      <header class="flex items-start gap-4">
        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 text-white shadow-lg shadow-amber-500/30"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            class="h-6 w-6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 3v7"></path>
            <circle cx="12" cy="14" r="3.5" fill="currentColor" stroke="none"
            ></circle>
            <path d="M4 19h16"></path>
            <path d="m7.5 16.5 1.5-1.5M16.5 16.5 15 15"></path>
          </svg>
        </div>
        <div>
          <h1 class="text-3xl font-bold tracking-tight text-stone-900">
            {t.heading}
          </h1>
          <p class="mt-1 max-w-xl text-stone-600">{t.tagline}</p>
        </div>
      </header>
      <div class="mt-10">
        <Calculator client:load />
      </div>
    </main>
  </body>
</html>
